/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/media/*
  X-Robots-Tag: noindex, noarchive

/assets/nico/video/court-v2/*
  X-Robots-Tag: noindex, noarchive

/sw.js
  Cache-Control: no-cache

/release.json
  Cache-Control: no-store

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Protect the canonical shared offline HTML shell.
# Cloudflare Web Analytics automatic injection respects no-transform.

/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/games/starfall-anglers/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/games/timberline-hunt/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/games/luma-lagoon/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/games/skullwing/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/games/mascaras-del-volcan/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/games/moonpaw/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
